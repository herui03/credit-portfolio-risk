# ── Data: never committed. Rebuilt from source by `make data`. ──
# LendingClub accepted-loans CSV is ~1.6 GB unzipped — far past GitHub's limits.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.duckdb
*.duckdb.wal

# ── Derived artefacts (regenerated by `make demo`) ──
excel/*.xlsx
!excel/.gitkeep
# Keep outputs/*.csv and tableau/*.csv — they ARE the evidence cited in docs/

# ── Tableau ──
*.twb
*.twbx
*.hyper

# ── Secrets ──
.env
*.pem
kaggle.json

# ── Python ──
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ── macOS / editors ──
.DS_Store
.vscode/
.idea/
